# Copy to .env and adjust. Consumed by docker-compose.yml.

# Host address the published port binds to. Defaults to 127.0.0.1 (loopback
# only) because the app has NO authentication — see docs/security.md.
# Set to 0.0.0.0 ONLY on a trusted LAN. Never expose to the internet without
# an authenticated reverse proxy or a VPN in front.
BIND_ADDR=127.0.0.1

# Host port the app is published on.
PORT=3000
